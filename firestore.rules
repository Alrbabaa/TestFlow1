rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['UEqGXe9B52Wp0T5sXfxcC72a5mq2', 'hJMZ8MAYrcRjHEOzxidDQwTjMI52']; }
    function isDeveloper() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'; }
    function manages(id) { return isAdmin() || (isDeveloper() && get(/databases/$(database)/documents/campaignPrivate/$(id)).data.developerId == request.auth.uid); }
    function text(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    function optionalText(v, n) { return v is string && v.size() <= n; }
    function campaignFields() { return ['name','slug','developerId','developerName','platform','testType','category','tagline','description','campaignGoal','iconUrl','durationDays','requiredTestersCount','currentTestersCount','status','rewardTitle','rewardValue','testingInstructions','createdAt','updatedAt']; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'developer_pending';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
    }
    match /developerRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == 'pending' && text(request.resource.data.name,100) && text(request.resource.data.companyName,120) && text(request.resource.data.email,254);
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
    match /publicCampaigns/{id} {
      allow get, list: if resource.data.status == 'active' || manages(id);
      allow create: if (isAdmin() || isDeveloper()) && request.resource.data.keys().hasOnly(campaignFields()) && request.resource.data.developerId == request.auth.uid && text(request.resource.data.name,120) && text(request.resource.data.slug,80) && request.resource.data.platform in ['android','ios'] && request.resource.data.testType in ['google_play_closed','testflight'] && request.resource.data.status in ['draft','active','paused','completed'];
      allow update: if manages(id) && request.resource.data.keys().hasOnly(campaignFields()) && request.resource.data.developerId == resource.data.developerId && request.resource.data.status in ['draft','active','paused','completed'];
      allow delete: if manages(id);
    }
    match /campaignPrivate/{id} {
      allow get, list: if manages(id);
      allow create: if (isAdmin() || isDeveloper()) && request.resource.data.developerId == request.auth.uid && text(request.resource.data.testUrl,2048) && getAfter(/databases/$(database)/documents/publicCampaigns/$(id)).data.developerId == request.auth.uid;
      allow update: if manages(id) && request.resource.data.developerId == resource.data.developerId && text(request.resource.data.testUrl,2048);
      allow delete: if manages(id);
    }
    match /applications/{id} {
      allow create: if !exists(/databases/$(database)/documents/applications/$(id)) && id == request.resource.data.campaignId + '_' + request.resource.data.emailKey && get(/databases/$(database)/documents/publicCampaigns/$(request.resource.data.campaignId)).data.status == 'active' && request.resource.data.developerId == get(/databases/$(database)/documents/campaignPrivate/$(request.resource.data.campaignId)).data.developerId && text(request.resource.data.testerName,120) && text(request.resource.data.testerEmail,254) && optionalText(request.resource.data.googlePlayEmail,254) && optionalText(request.resource.data.deviceModel,160) && optionalText(request.resource.data.testerCountry,120) && optionalText(request.resource.data.osVersion,80) && request.resource.data.osType in ['android','ios'] && request.resource.data.status == 'pending';
      allow get, list: if signedIn() && manages(resource.data.campaignId);
      allow update: if signedIn() && manages(resource.data.campaignId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','developerNotes','updatedAt']) && request.resource.data.status in ['pending','accepted','waiting_for_whitelisting','ready_to_join','joined','active','completed','inactive','rejected'];
      allow delete: if signedIn() && manages(resource.data.campaignId);
    }
  }
}
