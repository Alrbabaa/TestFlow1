# Firebase Web SDK configuration. VITE_ values are public web identifiers,
# never Admin SDK credentials or a service-account JSON.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0485544867
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned image upload. These are public client-side identifiers;
# never add CLOUDINARY_API_SECRET or any Cloudinary API secret to Vercel or Git.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
