# TestFlow Environment Variables
# Dev server runs on port 3000
PORT=3000

# Google Cloud SQL for PostgreSQL. Put real credentials only in untracked .env
# locally or the deployment platform's secret manager. Never commit real values.
# Optional alternative for non-Cloud-Run deployments. Leave empty for Cloud Run.
# Example shape only: postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=
CLOUD_SQL_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE_NAME
# Select exactly one: auth-proxy, private-ip, public-ssl.
CLOUD_SQL_MODE=auth-proxy

# Cloud Run native Cloud SQL integration: set this to the Unix socket path
# /cloudsql/PROJECT_ID:REGION:INSTANCE_NAME. If omitted, the server derives
# that same path from CLOUD_SQL_CONNECTION_NAME in auth-proxy mode.
# Do not use localhost in Cloud Run production.
SQL_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# SQL_SSL_MODE: disable only for local Auth Proxy; production direct modes use
# verify-ca or verify-full and require DATABASE_SSL_CA. Proxy mode defaults to
# disable on its local hop; the Cloud SQL Auth Proxy encrypts the remote tunnel.
SQL_SSL_MODE=disable
# Trusted PEM server CA required by verify-ca/verify-full direct connections.
DATABASE_SSL_CA=

SQL_POOL_MAX=10
SQL_CONNECT_TIMEOUT_MS=5000
SQL_IDLE_TIMEOUT_MS=30000

# Comma-separated Firebase Auth UIDs that are permitted to hold the admin role.
# Store the real UID list in the deployment secret manager, not in source control.
ADMIN_UIDS=
