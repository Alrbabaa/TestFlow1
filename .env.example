# Firebase Web SDK configuration. VITE_ values are public web identifiers,
# never Admin SDK credentials or a service-account JSON.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0485544867
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned upload configuration. These are public web identifiers;
# never add CLOUDINARY_API_SECRET, an API key, or any other secret to Vercel.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-only Vercel Function configuration. Never prefix these values with
# VITE_, never commit their values, and never expose them to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FIREBASE_ADMIN_SERVICE_ACCOUNT=
